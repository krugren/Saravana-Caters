{
  // ── Tailwind v4 CSS at-rules ───────────────────────────────────────────────
  // VS Code's built-in CSS validator doesn't know about @custom-variant, @theme,
  // or @apply. These are valid Tailwind v4 / postcss directives, not real errors.
  // Disable the built-in validator and let the Tailwind IntelliSense extension
  // (bradlc.vscode-tailwindcss) handle validation instead.
  "css.validate": false,
  "scss.validate": false,

  // ── Tailwind IntelliSense config ───────────────────────────────────────────
  // Tell the Tailwind extension where to find the config (Tailwind v4 uses CSS)
  "tailwindCSS.experimental.configFile": "src/app/globals.css",

  // ── File associations ──────────────────────────────────────────────────────
  "files.associations": {
    "*.css": "tailwindcss"
  },

  // ── TypeScript / Editor preferences ───────────────────────────────────────
  "typescript.tsdk": "node_modules/typescript/lib",
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
